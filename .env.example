# Copy to .env (git-ignored) for `docker compose up`.

# PostgreSQL started by docker compose
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Signing key for access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Staff accounts created on first start: admin@vrms.rw (Admin) and agent@vrms.rw (Agent)
ADMIN_PASSWORD=
AGENT_PASSWORD=

# Optional: "Continue with Google / GitHub". Redirect URIs to register with the provider:
#   http://localhost:8080/login/oauth2/code/google
#   http://localhost:8080/login/oauth2/code/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: real SMS through Africa's Talking (sandbox username is "sandbox"). Empty = simulated.
AT_USERNAME=sandbox
AT_API_KEY=

# Image to run; CI publishes ghcr.io/mbishflavien/vehicle-rental-management-system:latest
# VRMS_IMAGE=ghcr.io/mbishflavien/vehicle-rental-management-system:latest
