# Copy to application-secrets.properties (git-ignored) and fill in.
spring.datasource.password=your_postgres_password
# Generate with: openssl rand -base64 48
vrms.jwt.secret=change-me-to-a-long-random-base64-string
# Staff console sign-in (email defaults to admin@vrms.rw)
vrms.admin.password=choose-a-strong-password
# Optional demo rental agent: agent@vrms.rw
vrms.agent.password=choose-another-password
